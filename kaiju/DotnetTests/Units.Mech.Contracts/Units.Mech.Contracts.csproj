<Project Sdk="Microsoft.NET.Sdk">
  <!-- Mirrors the Unity assembly Game.Units.Mech.Contracts (sources under Assets/Game/Units/Mech/Contracts); same pattern as DotnetTests/Core. -->
  <PropertyGroup>
    <TargetFramework>netstandard2.1</TargetFramework>
    <AssemblyName>Game.Units.Mech.Contracts</AssemblyName>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="../../Assets/Game/Units/Mech/Contracts/**/*.cs" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="../Core.Contracts/Core.Contracts.csproj" />
    <ProjectReference Include="../Physics.Body.Contracts/Physics.Body.Contracts.csproj" />
    <ProjectReference Include="../Control.Contracts/Control.Contracts.csproj" />
  </ItemGroup>
</Project>
