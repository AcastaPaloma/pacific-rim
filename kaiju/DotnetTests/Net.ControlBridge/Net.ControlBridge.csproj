<Project Sdk="Microsoft.NET.Sdk">
  <!-- Mirrors the Unity assembly Game.Net.ControlBridge (netstandard2.1, engine-free). T-030. Tests live in a subfolder with their own asmdef, hence non-recursive. -->
  <PropertyGroup>
    <TargetFramework>netstandard2.1</TargetFramework>
    <AssemblyName>Game.Net.ControlBridge</AssemblyName>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="../../Assets/Game/Net/ControlBridge/*.cs" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="../Core.Contracts/Core.Contracts.csproj" />
    <ProjectReference Include="../Net.Contracts/Net.Contracts.csproj" />
    <ProjectReference Include="../Net/Net.csproj" />
    <ProjectReference Include="../Control.Contracts/Control.Contracts.csproj" />
  </ItemGroup>
</Project>
