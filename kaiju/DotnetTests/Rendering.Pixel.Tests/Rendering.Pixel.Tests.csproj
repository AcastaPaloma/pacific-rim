<Project Sdk="Microsoft.NET.Sdk">
  <!-- Runs the same NUnit sources that Unity EditMode runs (Assets/Game/Rendering/Pixel/Tests/EditMode). -->
  <PropertyGroup>
    <TargetFramework>net11.0</TargetFramework>
    <AssemblyName>Game.Rendering.Pixel.Tests</AssemblyName>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="../../Assets/Game/Rendering/Pixel/Tests/EditMode/**/*.cs" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="../Rendering.Pixel.Contracts/Rendering.Pixel.Contracts.csproj" />
    <ProjectReference Include="../Rendering.Pixel.Maths/Rendering.Pixel.Maths.csproj" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.12.0" />
    <PackageReference Include="NUnit" Version="3.14.0" />
    <PackageReference Include="NUnit3TestAdapter" Version="4.6.0" />
  </ItemGroup>
</Project>
