<Project Sdk="Microsoft.NET.Sdk">
  <!-- T-030c: the engine-free adapters of the composition layer (PlaceholderDamageAdapter) and their tests, compiled without Unity. The same test source runs in Unity EditMode. -->
  <PropertyGroup>
    <TargetFramework>net11.0</TargetFramework>
    <AssemblyName>Game.Composition.Adapters.Tests</AssemblyName>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="../../Assets/Game/Composition/Runtime/PlaceholderDamageAdapter.cs" />
    <Compile Include="../../Assets/Game/Composition/Tests/EditMode/PlaceholderDamageAdapterTests.cs" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="../Hangar/Hangar.csproj" />
    <ProjectReference Include="../Hangar.Contracts/Hangar.Contracts.csproj" />
    <ProjectReference Include="../Units.Placeholder.Contracts/Units.Placeholder.Contracts.csproj" />
    <ProjectReference Include="../Core.Contracts/Core.Contracts.csproj" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.12.0" />
    <PackageReference Include="NUnit" Version="3.14.0" />
    <PackageReference Include="NUnit3TestAdapter" Version="4.6.0" />
  </ItemGroup>
</Project>
