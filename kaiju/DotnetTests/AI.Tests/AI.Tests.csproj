<Project Sdk="Microsoft.NET.Sdk">
  <!-- NUnit tests for the scripted kaiju brain (pure C#). T-032. -->
  <PropertyGroup>
    <TargetFramework>net11.0</TargetFramework>
    <AssemblyName>Game.AI.Tests</AssemblyName>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="Dotnet/**/*.cs" />
    <Compile Include="../../Assets/Game/AI/Tests/EditMode/**/*.cs" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="../AI.Harness/AI.Harness.csproj" />
    <ProjectReference Include="../AI.Scripted/AI.Scripted.csproj" />
    <ProjectReference Include="../AI.Contracts/AI.Contracts.csproj" />
    <ProjectReference Include="../Core.Contracts/Core.Contracts.csproj" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.12.0" />
    <PackageReference Include="NUnit" Version="3.14.0" />
    <PackageReference Include="NUnit3TestAdapter" Version="4.6.0" />
  </ItemGroup>
</Project>
