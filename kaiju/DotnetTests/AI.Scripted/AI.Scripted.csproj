<Project Sdk="Microsoft.NET.Sdk">
  <!-- Mirrors the Unity assembly Game.AI.Scripted (netstandard2.1, C# 9, engine-free). T-032. -->
  <PropertyGroup>
    <TargetFramework>netstandard2.1</TargetFramework>
    <AssemblyName>Game.AI.Scripted</AssemblyName>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="../../Assets/Game/AI/Scripted/**/*.cs" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="../Core.Contracts/Core.Contracts.csproj" />
    <ProjectReference Include="../AI.Contracts/AI.Contracts.csproj" />
  </ItemGroup>
</Project>
