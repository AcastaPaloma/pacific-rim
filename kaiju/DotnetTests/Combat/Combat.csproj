<Project Sdk="Microsoft.NET.Sdk">
  <!-- Mirrors the Unity assembly Game.Combat (netstandard2.1, engine-free). T-040. -->
  <PropertyGroup>
    <TargetFramework>netstandard2.1</TargetFramework>
    <AssemblyName>Game.Combat</AssemblyName>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="../../Assets/Game/Combat/Runtime/**/*.cs" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="../Core.Contracts/Core.Contracts.csproj" />
    <ProjectReference Include="../WorldDestruction.Contracts/WorldDestruction.Contracts.csproj" />
    <ProjectReference Include="../Combat.Contracts/Combat.Contracts.csproj" />
  </ItemGroup>
</Project>
