<Project Sdk="Microsoft.NET.Sdk">
  <!-- Mirrors the Unity assembly Game.World.Geo.Contracts (netstandard2.1, C# 9, engine-free). T-003. -->
  <PropertyGroup>
    <TargetFramework>netstandard2.1</TargetFramework>
    <AssemblyName>Game.World.Geo.Contracts</AssemblyName>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="../../Assets/Game/World/Geo/Contracts/**/*.cs" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="../Core.Contracts/Core.Contracts.csproj" />
  </ItemGroup>
</Project>
