<Project Sdk="Microsoft.NET.Sdk">
  <!-- Mirrors the Unity assembly Game.Units.Mech (sources under Assets/Game/Units/Mech/Runtime); same pattern as DotnetTests/Core. -->
  <PropertyGroup>
    <TargetFramework>netstandard2.1</TargetFramework>
    <AssemblyName>Game.Units.Mech</AssemblyName>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="../../Assets/Game/Units/Mech/Runtime/**/*.cs" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="../Core.Contracts/Core.Contracts.csproj" />
    <ProjectReference Include="../Physics.Body.Contracts/Physics.Body.Contracts.csproj" />
    <ProjectReference Include="../Control.Contracts/Control.Contracts.csproj" />
    <ProjectReference Include="../Units.Mech.Contracts/Units.Mech.Contracts.csproj" />
  </ItemGroup>
</Project>
