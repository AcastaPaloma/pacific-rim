<Project Sdk="Microsoft.NET.Sdk">
  <!-- Mirrors the Unity assembly Game.UI (pure view-model code): .NET Standard 2.1, C# 9, engine-free. -->
  <PropertyGroup>
    <TargetFramework>netstandard2.1</TargetFramework>
    <AssemblyName>Game.UI</AssemblyName>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="../../Assets/Game/UI/Runtime/**/*.cs" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="../UI.Contracts/UI.Contracts.csproj" />
  </ItemGroup>
</Project>
