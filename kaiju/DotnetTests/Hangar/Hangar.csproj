<Project Sdk="Microsoft.NET.Sdk">
  <!-- Mirrors the Unity assembly Game.Hangar (netstandard2.1, C# 9, engine-free). T-034. -->
  <PropertyGroup>
    <TargetFramework>netstandard2.1</TargetFramework>
    <AssemblyName>Game.Hangar</AssemblyName>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="../../Assets/Game/Hangar/Runtime/**/*.cs" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="../Core.Contracts/Core.Contracts.csproj" />
    <ProjectReference Include="../WorldGeo.Contracts/WorldGeo.Contracts.csproj" />
    <ProjectReference Include="../Hangar.Contracts/Hangar.Contracts.csproj" />
  </ItemGroup>
</Project>
