<Project Sdk="Microsoft.NET.Sdk">
  <!-- Runs the same NUnit sources that Unity EditMode runs (Assets/Game/World/Seismic/Tests/EditMode). T-027. -->
  <PropertyGroup>
    <TargetFramework>net11.0</TargetFramework>
    <AssemblyName>Game.World.Seismic.Tests</AssemblyName>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="../../Assets/Game/World/Seismic/Tests/EditMode/**/*.cs" />
    <Compile Include="Dotnet/**/*.cs" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="../WorldSeismic/WorldSeismic.csproj" />
    <ProjectReference Include="../Core/Core.csproj" />
    <ProjectReference Include="../WorldDestruction/WorldDestruction.csproj" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.12.0" />
    <PackageReference Include="NUnit" Version="3.14.0" />
    <PackageReference Include="NUnit3TestAdapter" Version="4.6.0" />
  </ItemGroup>
</Project>
