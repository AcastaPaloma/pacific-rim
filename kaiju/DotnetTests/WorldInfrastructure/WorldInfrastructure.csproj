    <ProjectReference Include="../WorldGeo/WorldGeo.csproj" />
    <ProjectReference Include="../WorldGeo.Contracts/WorldGeo.Contracts.csproj" />
    <ProjectReference Include="../WorldInfrastructure.Contracts/WorldInfrastructure.Contracts.csproj" />
  </ItemGroup>
</Project>
