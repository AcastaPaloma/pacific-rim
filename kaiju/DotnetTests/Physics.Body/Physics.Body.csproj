<Project Sdk="Microsoft.NET.Sdk">
  <!-- Mirrors the Unity assembly Game.Physics.Body (sources under Assets/Game/Physics/Body/Runtime); same pattern as DotnetTests/Core. -->
  <PropertyGroup>
    <TargetFramework>netstandard2.1</TargetFramework>
    <AssemblyName>Game.Physics.Body</AssemblyName>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="../../Assets/Game/Physics/Body/Runtime/**/*.cs" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="../Core.Contracts/Core.Contracts.csproj" />
    <ProjectReference Include="../Physics.Body.Contracts/Physics.Body.Contracts.csproj" />
  </ItemGroup>
</Project>
