<Project Sdk="Microsoft.NET.Sdk">
  <!-- Mirrors the Unity assembly Game.Core: .NET Standard 2.1 (Unity 6000.6 API surface), C# 9, references only Contracts. -->
  <PropertyGroup>
    <TargetFramework>netstandard2.1</TargetFramework>
    <AssemblyName>Game.Core</AssemblyName>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="../../Assets/Game/Core/Runtime/**/*.cs" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="../Core.Contracts/Core.Contracts.csproj" />
  </ItemGroup>
</Project>
