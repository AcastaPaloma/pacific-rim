<Project Sdk="Microsoft.NET.Sdk">
  <!-- Mirrors the Unity assembly Game.Audio.Contracts (netstandard2.1, C# 9, engine-free). T-190. -->
  <PropertyGroup>
    <TargetFramework>netstandard2.1</TargetFramework>
    <AssemblyName>Game.Audio.Contracts</AssemblyName>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="../../Assets/Game/Audio/Contracts/**/*.cs" />
  </ItemGroup>
</Project>
