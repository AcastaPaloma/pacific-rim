<Project Sdk="Microsoft.NET.Sdk">
  <!-- Mirrors the Unity assembly Game.Units.Mech.Tests (sources under Assets/Game/Units/Mech/Tests/EditMode); same pattern as DotnetTests/Core. -->
  <PropertyGroup>
    <TargetFramework>net11.0</TargetFramework>
    <AssemblyName>Game.Units.Mech.Tests</AssemblyName>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="../../Assets/Game/Units/Mech/Tests/EditMode/**/*.cs" />
    <Compile Include="ReferenceValidityTests.cs" />
    <Compile Include="FeedForwardTests.cs" />
    <Compile Include="StanceImpedanceTests.cs" />
    <Compile Include="YawCompensationTests.cs" />
    <Compile Include="OptimisedReferenceTests.cs" />
    <Compile Include="StanceScheduleConfigTests.cs" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="../Core/Core.csproj" />
    <ProjectReference Include="../Physics.Body/Physics.Body.csproj" />
    <ProjectReference Include="../Control/Control.csproj" />
    <ProjectReference Include="../Units.Mech/Units.Mech.csproj" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.12.0" />
    <PackageReference Include="NUnit" Version="3.14.0" />
    <PackageReference Include="NUnit3TestAdapter" Version="4.6.0" />
  </ItemGroup>
</Project>
