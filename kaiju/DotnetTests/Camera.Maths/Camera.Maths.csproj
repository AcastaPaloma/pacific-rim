<Project Sdk="Microsoft.NET.Sdk">
  <!-- Mirrors the Unity assembly Game.Camera.Maths: .NET Standard 2.1, C# 9, engine-free. -->
  <PropertyGroup>
    <TargetFramework>netstandard2.1</TargetFramework>
    <AssemblyName>Game.Camera.Maths</AssemblyName>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="../../Assets/Game/Camera/Maths/**/*.cs" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="../Camera.Contracts/Camera.Contracts.csproj" />
    <ProjectReference Include="../Rendering.Pixel.Contracts/Rendering.Pixel.Contracts.csproj" />
  </ItemGroup>
</Project>
